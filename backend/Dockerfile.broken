# «Битая» версия сервиса — нужна только для демонстрации отката (Лаба 3).
#
# Образ собирается нормально, но контейнер сразу падает на старте.
# Так я имитирую плохой релиз: healthcheck красный, /api/pets не отвечает,
# и надо откатиться на предыдущий тег.

FROM python:3.12-slim

WORKDIR /app

COPY main.py pet_logic.py ./

EXPOSE 8000

# Вместо uvicorn запускаем скрипт, который сразу завершается с ошибкой
CMD ["python", "-c", "raise SystemExit('битый релиз: сервис не стартует')"]
